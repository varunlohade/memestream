import puppeteer, { type Page } from "puppeteer-core";
const BASE = "http://127.0.0.1:3000", OUT = new URL(".", import.meta.url).pathname;
const MIRA = "CZT11DjpQ4EE3YsHsAvQSb211b4UmghVUvjYf5WrHmvR", DEV = "6wbBU6NMj42AAzC9pJW4qPSc4sutWg23wPZ8jSTQKjod";
const W = (await (await fetch(`${BASE}/api/dev-wallet`)).json()).address;
const det = async (m: string) => (await (await fetch(`${BASE}/api/coins/${m}?wallet=${W}`)).json());
const log = (...a: unknown[]) => console.log(new Date().toISOString().slice(11,19), ...a);
const browser = await puppeteer.launch({ executablePath: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome", headless: true, args: ["--mute-audio"] });
const p = await browser.newPage(); await p.setViewport({ width: 1280, height: 1100 });
await p.setRequestInterception(true);
p.on("request", (r) => { const h = new URL(r.url()).hostname; ["127.0.0.1","fonts.googleapis.com","fonts.gstatic.com"].includes(h) || r.url().startsWith("data:") ? r.continue() : r.abort(); });
p.on("pageerror", (e) => log("PAGEERROR", (e as Error).message));
const t = (s: string) => `::-p-text(${s})`;
const click = (s: string) => p.locator(t(s)).setTimeout(20000).click();
const waitText = (s: string, to = 30000) => p.waitForFunction((x) => document.body.innerText.includes(x), { timeout: to }, s);
const shot = (n: string) => p.screenshot({ path: `${OUT}${n}.png` });
const until = async (m: string, f: (d: any) => boolean) => { for (let i = 0; i < 90; i++) { const d = await det(m); if (f(d)) return d; await new Promise(r => setTimeout(r, 1000)); } throw new Error("timeout"); };
try {
  for (const path of ["/", `/coin/${MIRA}`, `/coin/${DEV}`]) await fetch(BASE + path);
  await p.goto(BASE, { waitUntil: "domcontentloaded" }); await new Promise(r => setTimeout(r, 3000));
  await click("Connect"); await click("Test wallet (localhost)");
  await p.waitForFunction(() => !document.querySelector(".wallet")?.textContent?.includes("Connect"), { timeout: 15000 });
  await p.goto(`${BASE}/coin/${MIRA}`, { waitUntil: "domcontentloaded" }); await waitText("Graduation");
  const d0 = await det(MIRA); log("start holdings", JSON.stringify(d0.holdings));
  const inp = await p.waitForSelector('input[aria-label^="Amount in"]'); await inp!.click({ clickCount: 3 }); await p.keyboard.press("Backspace"); await inp!.type("0.2");
  await waitText("You get about"); await shot("01-buy-quote");
  await p.locator(`button${t("Buy MIRA")}:not([disabled])`).setTimeout(20000).click();
  const d1 = await until(MIRA, (d) => Number(d.holdings?.coins ?? 0) > Number(d0.holdings?.coins ?? 0));
  log("after buy", JSON.stringify(d1.holdings)); await new Promise(r => setTimeout(r, 2000)); await shot("02-after-buy");
  await p.locator(`button[aria-pressed]${t("Sell")}`).setTimeout(20000).click();
  const chips = await p.$$eval("button", (b) => b.map(x => x.textContent?.trim()).filter(Boolean)); log("buttons", JSON.stringify(chips));
  await click(chips.includes("Max") ? "Max" : "100%");
  await waitText("You get about").catch(() => log("no 'You get about' on sell"));
  await shot("03-sell-quote");
  await p.locator(`button${t("Sell MIRA")}:not([disabled])`).setTimeout(20000).click();
  const d2 = await until(MIRA, (d) => Number(d.holdings?.coins ?? 0) < Number(d1.holdings?.coins ?? 0));
  log("after sell", JSON.stringify(d2.holdings)); await new Promise(r => setTimeout(r, 2000)); await shot("04-after-sell");
  log("sell page text:", (await p.evaluate(() => document.body.innerText)).slice(0, 1500).replace(/\n+/g, " | "));
  await p.goto(`${BASE}/coin/${DEV}`, { waitUntil: "domcontentloaded" }); await waitText("Graduation"); await new Promise(r => setTimeout(r, 3000));
  await shot("05-own-coin");
  const buyBtns = await p.$$eval("button", (b) => b.filter(x => /Buy/.test(x.textContent ?? "")).map(x => ({ t: x.textContent, dis: (x as HTMLButtonElement).disabled })));
  log("own coin buy buttons", JSON.stringify(buyBtns));
  log("own coin text:", (await p.evaluate(() => document.body.innerText)).slice(0, 1500).replace(/\n+/g, " | "));
} catch (e) { log("FAIL", (e as Error).message); await shot("99-fail"); }
await browser.close();
